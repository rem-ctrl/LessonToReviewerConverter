/* Modern Dark Studio QSS — Pure Black Background, Sleek Dark Panels, White Text, Simple Fonts */

QMainWindow {
    background-color: #000000;
    color: #FFFFFF;
}

QWidget {
    font-family: "Segoe UI", -apple-system, Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #FFFFFF;
}

/* Header Banner */
#HeaderTitle {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.5px;
    margin-bottom: 2px;
}

#HeaderSubtitle {
    font-size: 12px;
    color: #A0A0A0;
}

/* Drag and Drop Zone */
#DropZone {
    background-color: #141414;
    border: 1.5px dashed #2A2A2A;
    border-radius: 14px;
    padding: 24px;
}

#DropZone[hover="true"] {
    background-color: #1A1A1A;
    border: 1.5px dashed #0A73FD;
}

#DropZoneIconText {
    font-size: 13px;
    font-weight: 600;
    color: #0A73FD;
    letter-spacing: 1px;
}

#DropZoneText {
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
}

#DropZoneSubtext {
    font-size: 12px;
    color: #808080;
}

/* Group Boxes & Dark Panels */
QGroupBox {
    background-color: #141414;
    border: 1px solid #262626;
    border-radius: 12px;
    margin-top: 10px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #FFFFFF;
}

/* Line Inputs */
QLineEdit {
    background-color: #1E1E1E;
    border: 1px solid #2D2D2D;
    border-radius: 8px;
    padding: 7px 10px;
    color: #FFFFFF;
    font-size: 12.5px;
}

QLineEdit:focus {
    border: 1px solid #0A73FD;
    background-color: #222222;
}

/* Standard Buttons */
QPushButton {
    background-color: #222222;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 12.5px;
}

QPushButton:hover {
    background-color: #2A2A2A;
    border-color: #444444;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #181818;
}

/* Main Pill Action Button matching reference */
#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0A73FD, stop:0.5 #72BCFF, stop:1 #FFDDB7);
    color: #000000;
    border: none;
    border-radius: 20px;
    font-weight: 700;
    font-size: 14px;
    padding: 11px 24px;
    letter-spacing: 0.3px;
}

#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1A7FFD, stop:0.5 #84C5FF, stop:1 #FFE3C4);
}

#PrimaryButton:disabled {
    background: #222222;
    color: #555555;
    border: 1px solid #333333;
}

#AccentButton {
    background-color: #262626;
    color: #FFFFFF;
    border: 1px solid #383838;
    border-radius: 8px;
    font-weight: 600;
    padding: 8px 16px;
}

#AccentButton:hover {
    background-color: #333333;
    border-color: #0A73FD;
}

/* Progress Bar */
QProgressBar {
    background-color: #141414;
    border: 1px solid #262626;
    border-radius: 8px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 11px;
    height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0A73FD, stop:1 #72BCFF);
    border-radius: 7px;
}

/* Terminal Log Output */
QTextEdit {
    background-color: #101010;
    border: 1px solid #222222;
    border-radius: 10px;
    color: #E0E0E0;
    font-family: "Consolas", "Segoe UI", monospace;
    font-size: 11.5px;
    padding: 8px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #141414;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2D2D2D;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #444444;
}
